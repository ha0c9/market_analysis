# Copy to .env for local runs. Never commit .env.
AI_API_KEY=
# Paste the OpenAI-compatible Base URL from the vendor console as-is.
# Example: https://node-hk.sssaiapi.com/api/v1
AI_BASE_URL=
# Copy the exact model ID from the vendor console. v1 uses DeepSeek V4 Flash.
AI_MODEL_PLANNER=deepseek-v4-flash
AI_MODEL_SYNTHESIZER=deepseek-v4-flash
